package-as: TransmogHub

ignore:
  - docs
  - tests
  - tools
  - README.md
  - VERSION

# Список изменений для CurseForge, Wago и GitHub — по-английски, из файла (а не из коммитов)
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

# Встроенная база источников (из AllTheThings) — отдельный аддон, грузится по требованию
move-folders:
  TransmogHub/TransmogHub_Sources: TransmogHub_Sources
